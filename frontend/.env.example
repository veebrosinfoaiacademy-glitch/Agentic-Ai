# Frontend configuration.
#
# Only VITE_-prefixed variables reach the browser bundle, and everything here
# is PUBLIC. Never put GROQ_API_KEY, MONGODB_URI or JWT_SECRET in this file:
# the browser talks to FastAPI, and FastAPI talks to Groq and MongoDB.
#
#   React  ->  FastAPI  ->  Groq / MongoDB
#
# Local development:
VITE_API_BASE_URL=http://localhost:8000/api
#
# Production: set this in the hosting platform to the deployed API origin,
# for example https://ai-productivity-agents-api.onrender.com/api
