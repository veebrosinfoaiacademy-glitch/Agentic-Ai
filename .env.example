# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file.

# ---- Groq (required from Phase 4) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- MongoDB Atlas (required from Phase 3) ----
MONGODB_URI=
MONGODB_DB_NAME=ai_productivity_agents

# ---- Auth (required from Phase 8) ----
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- App ----
APP_NAME=AI Productivity Agents API
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
