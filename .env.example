# Backend configuration.
#
# Copy to backend/.env for local development and fill in real values.
# In production these are set in the hosting platform's dashboard —
# this file is committed and must never contain a real value.

# ---- Groq ----
# Get a key at https://console.groq.com -> API Keys
GROQ_API_KEY=
# Must be a model ID listed at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# ---- MongoDB Atlas ----
MONGODB_URI=
MONGODB_DB_NAME=ai_productivity_agents

# ---- Authentication ----
# Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anything shorter than 32 bytes is logged as weak at startup (RFC 7518).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- Application ----
APP_NAME=AI Productivity Agents API
APP_VERSION=1.0.0
# false in production: keeps application loggers at INFO rather than DEBUG.
DEBUG=true

# Comma-separated allowed origins. In production this must be exactly the
# deployed frontend origin. Never "*" — it is invalid alongside credentials
# and would let any site call the API with a user's token.
#   local:      http://localhost:5173
#   production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173

# ---- AI usage limits ----
# Per user. 0 disables a limit entirely.
AI_RATE_LIMIT_PER_HOUR=100
AI_RATE_LIMIT_PER_DAY=500
USAGE_RETENTION_DAYS=2

# ---- Uploads ----
# Caps the uploaded file.
MAX_UPLOAD_MB=10
# Caps the text extracted from it — a different limit, since a small file can
# yield a great deal of text.
DOCUMENT_MAX_EXTRACTED_CHARACTERS=100000
