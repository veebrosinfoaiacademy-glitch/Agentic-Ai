# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file.

# ---- Groq (required from Phase 4) ----
# Get a key at https://console.groq.com -> API Keys
GROQ_API_KEY=
# Must be a model ID listed at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# ---- MongoDB Atlas (required from Phase 3) ----
MONGODB_URI=
MONGODB_DB_NAME=ai_productivity_agents

# ---- Auth (required from Phase 8) ----
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- App ----
APP_NAME=AI Productivity Agents API
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
